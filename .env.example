# Supabase Public Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Supabase Server-Only Secret Key (Never expose to client)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# PostgreSQL Connection String (for migrations / admin scripts only)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Initial Super Administrator Provisioning (Server-only, used once during provisioning)
ADMIN_INITIAL_USERNAME=admin@invytra
ADMIN_INITIAL_PASSWORD=change-me-secure-random-password

# Site Canonical URL — in production set this to the real domain
# (e.g. https://azhumathimayam.vercel.app). It drives SEO: canonical
# URLs, sitemap, robots.txt, Open Graph and structured data.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
